# Auto-downloaded distro tarballs (when no sibling clone is present).
.distro-cache/

# Playwright outputs
test-results/
test-artifacts/
playwright-report/
tests/playwright/node_modules/

# Editor/OS noise
.vscode/
.idea/
.DS_Store
*.swp

# PHI / UAT artifacts — patient-detail screenshots and lab data exports must
# NEVER be committed (data-governance). The repo has zero tracked files of
# these types; use `git add -f` for an intentional, PHI-free fixture.
*.png
*.csv
*.xls
*.xlsx
*.pdf

# Secrets / credentials — env config and Playwright stored auth state.
.env
**/.env
**/.auth/
