{
  "info": {
    "name": "OpenELIS mgtest \u2014 QC Validation",
    "description": "Postman trigger collection for the Madagascar mgtest server. It drives QC scenarios through the analyzer mock API across ASTM, FILE, and HL7 lanes.\n\nBoundary: Postman talks only to the mock over HTTP. The mock owns protocol generation and all internal bridge delivery details.\n\nValidation authority: OpenELIS UI. After triggers run, validate outcomes in the QC Dashboard, Alerts, and Instrument Detail pages.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "noauth"
  },
  "variable": [
    {
      "key": "mock_url",
      "value": "https://mock.mgtest.openelis-global.org",
      "type": "string"
    },
    {
      "key": "oe_url",
      "value": "https://mgtest.openelis-global.org",
      "type": "string"
    },
    {
      "key": "oe_admin",
      "value": "admin",
      "type": "string"
    },
    {
      "key": "oe_admin_pass",
      "value": "adminADMIN!",
      "type": "string"
    }
  ],
