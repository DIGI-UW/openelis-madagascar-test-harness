    {
      "name": "2. ASTM QC \u2014 GeneXpert (HIV-VL)",
      "description": "GeneXpert ASTM lane \u2014 LOT-HIVVL-N (mean=1250, SD=125). The OE-side qcRule is `FIELD_EQUALS targetField=O.12 operand=Q` (the ASTM Action Code).",
      "item": [
        {
          "name": "POST baseline pass (qc_deviation=0.5)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"qc\": true,\n  \"qc_deviation\": 0.5\n}"
            },
            "url": {
              "raw": "{{mock_url}}/simulate/astm/genexpert_astm",
              "host": [
                "{{mock_url}}"
              ],
              "path": [
                "simulate",
                "astm",
                "genexpert_astm"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "pm.test('200 OK', () => pm.expect(pm.response.code).to.equal(200));",
                  "pm.test('qc=true echoed', () => pm.expect(json.qc).to.equal(true));",
                  "pm.test('status provided', () => pm.expect(json.status).to.be.oneOf(['completed', 'uploaded']));"
                ],
                "type": "text/javascript"
              }
            }
