    {
      "name": "5. OE-Side Verification",
      "description": "Query OpenELIS REST endpoints to confirm the QC pipeline state landed correctly. All requests use HTTP Basic with {{oe_admin}}:{{oe_admin_pass}}.",
      "auth": {
        "type": "basic",
        "basic": [
          {
            "key": "username",
            "value": "{{oe_admin}}",
            "type": "string"
          },
          {
            "key": "password",
            "value": "{{oe_admin_pass}}",
            "type": "string"
          }
        ]
      },
      "item": [
        {
          "name": "GET QC violations (unresolved)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{oe_url}}/api/OpenELIS-Global/rest/qc/violations?unresolved=true",
              "host": [
                "{{oe_url}}"
              ],
              "path": [
                "api",
                "OpenELIS-Global",
                "rest",
                "qc",
                "violations"
              ],
              "query": [
                {
                  "key": "unresolved",
                  "value": "true"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200 OK', () => pm.expect(pm.response.code).to.equal(200));",
                  "pm.test('response is an array', () => pm.expect(pm.response.json()).to.be.an('array'));"
